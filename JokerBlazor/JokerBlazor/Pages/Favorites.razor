@page "/favorites"
@using JokerBlazor.Models
@inject JokeLibrary Library
@inject ISnackbar Snackbar

<PageTitle>Favorites · Joker's Manor</PageTitle>

<header class="page-header">
    <MudText Typo="Typo.h3" HtmlTag="h1" Class="page-title">Favorites</MudText>
    <MudText Typo="Typo.body1" Class="page-lede">
        Saved on this device, so they are still here when the network is not.
    </MudText>
</header>

<MudPaper Class="panel joke-panel" Elevation="0">
    <MudTextField T="string" Value="_search" ValueChanged="OnSearch" Label="Search favorites" Variant="Variant.Outlined" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    @if (_visible.Count == 0)
    {
        <MudText Typo="Typo.body1" Class="page-lede">@(_ready ? "Nothing saved matches that search." : "Loading saved jokes…")</MudText>
        @if (!_ready)
        {
            <MudSkeleton Width="70%" Height="1.4rem" />
        }
    }
    else
    {
        <MudList T="JokeCard" Dense="true">
            @foreach (var joke in _visible)
            {
                <MudListItem T="JokeCard">
                    <div class="favorite-row">
                        <div>
                            <MudText Typo="Typo.subtitle1">@joke.Primary</MudText>
                            @if (!string.IsNullOrWhiteSpace(joke.Punchline))
                            {
                                <MudText Typo="Typo.body2">@joke.Punchline</MudText>
                            }
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Inherit" aria-label="@($"Remove {joke.Primary}")" OnClick="@(() => Remove(joke.Id))" />
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

<MudPaper Class="panel joke-panel" Elevation="0">
    <MudText Typo="Typo.h6" HtmlTag="h2">Your top jokes</MudText>
    @if (_top.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="page-lede">Thumbs-up a joke and it will land here.</MudText>
    }
    else
    {
        @foreach (var joke in _top)
        {
            <MudText Typo="Typo.body1" Class="top-joke">@joke.Primary</MudText>
        }
    }
</MudPaper>

@code {
    private string? _search;
    private bool _ready;
    private IReadOnlyList<JokeCard> _visible = [];
    private IReadOnlyList<JokeCard> _top = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Library.EnsureLoadedAsync();
        _ready = true;
        Refresh();
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        if (_ready)
        {
            Refresh();
        }
    }

    private void Refresh()
    {
        _visible = Library.Favorites.Search(_search);
        _top = Library.Ratings.Top();
    }

    private Task OnSearch(string value)
    {
        _search = value;
        Refresh();
        return Task.CompletedTask;
    }

    private async Task Remove(int id)
    {
        await Library.RemoveFavoriteAsync(id);
        Refresh();
        Snackbar.Add("Removed from favorites", Severity.Info);
    }
}
